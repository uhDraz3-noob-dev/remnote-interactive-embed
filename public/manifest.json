{
  "manifestVersion": 1,
  "id": "interactive-embed",
  "name": "Interactive Embed",
  "author": "Usman",
  "repoUrl": "https://github.com/uhDraz3-noob-dev/remnote-interactive-embed",
  "version": {
    "major": 0,
    "minor": 3,
    "patch": 1
  },
  "theme": [],
  "enableOnMobile": true,
  "description": "Paste interactive HTML, CSS, and JavaScript embeds directly beneath a Rem.",
  "requestNative": false,
  "requiredScopes": [
    {
      "type": "FocusedSubtree",
      "level": "ReadCreateModify"
    },
    {
      "type": "Powerup",
      "powerupCode": "interactive_embed_powerup",
      "level": "ReadCreateModify"
    }
  ]
}
